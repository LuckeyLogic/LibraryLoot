rules_version = '2';

// Library Loot — Firestore Security Rules
//
// v1 (ITEM 1): Deny everything by default. No collection has been
// designed for client access yet — that begins with ITEM 2 (auth) and
// the per-tenant data model in SPEC.md §3.
//
// Multi-tenant boundary (planned): once auth ships, every request will
// be checked against the user's custom claim `tenant`. A user with
// claim `tenant: 'luckey-logic'` may only read/write documents whose
// path begins with `/luckey-logic/_main/...`. Cross-tenant queries are
// forbidden.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
