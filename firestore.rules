rules_version = '2';

// Library Loot — Firestore Security Rules (ITEM 2c)
//
// Multi-tenant model: every document lives under a top-level collection
// keyed by tenant ID (e.g. /luckey-logic/_main/...). A signed-in user has
// a `tenant` custom claim set by either bootstrapTenantClaim (parents) or
// claimSetupToken (admins) — both Cloud Functions. The `admin` custom
// claim is set only by claimSetupToken.
//
// Allow logic by collection (forward-looking; collections that don't
// exist yet are simply denied by the absence of an allow rule):
//
//   /_setup_tokens/{tokenHash}
//     - Deny all clients. Cloud Functions (Admin SDK) bypass rules.
//
//   /{tenantId}/_main
//     - Read:  tenant member (parents + admins of this tenant)
//     - Write: admin of this tenant
//
//   /{tenantId}/_main/users/{uid}
//     - Read:   the user themselves, OR any admin of this tenant.
//     - Create: deny clients (Cloud Functions create user docs via bootstrap).
//     - Update: admin (any field), OR the user themselves (only the
//               mirrored profile fields — displayName, photoURL, email,
//               lastSeenAt, lastModified — never role, createdAt,
//               promotedToAdminAt, or anything else). ITEM 9c.2.
//     - Delete: admin only.
//
//   /{tenantId}/_main/users/{uid}/lastModifieds/{lmId}
//     - Append-only audit trail. The previous `lastModified` summary
//       on the user doc gets archived here in the same batch when the
//       doc is updated. Read by self or admin; create by self or
//       admin; never updated or deleted (immutable history).
//
//   /{tenantId}/_main/lootSessions/{sessionId}
//     - Per-session chat log for the LOOT admin assistant. ITEM 9c.1a.
//     - Read by any admin of the tenant; create by an admin whose
//       UID matches the session's userUid; update by the session's
//       original owner; delete by any tenant admin.
//
//   /{tenantId}/_main/users/{uid}/children/{childId}
//     - Read/write: the owning parent, OR any admin of this tenant
//
// Anything not explicitly allowed is denied. New collections (books,
// prizes, sponsors, challenges, redemptions, sponsorInquiries) get
// added in their corresponding ITEMs.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──

    function isSignedIn() {
      return request.auth != null;
    }

    function inTenant(tenantId) {
      return isSignedIn() && request.auth.token.tenant == tenantId;
    }

    function isTenantAdmin(tenantId) {
      return inTenant(tenantId) && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── SETUP TOKENS ── (server-only)
    match /_setup_tokens/{tokenHash} {
      allow read, write: if false;
    }

    // ── TENANT SETTINGS ──
    // Public-read by design — the doc contains operator contact info,
    // legal supplements, and tenant branding that surface on the
    // public About / Privacy / Terms pages for ANY visitor (signed in
    // or not). Nothing here is sensitive. Only admins of this tenant
    // can write.
    match /{tenantId}/_main {
      allow read : if true;
      allow write: if isTenantAdmin(tenantId);
    }

    // ── USERS ──
    match /{tenantId}/_main/users/{uid} {
      allow read  : if (isSelf(uid) && inTenant(tenantId)) ||
                       isTenantAdmin(tenantId);

      // Doc creation stays server-only: bootstrapTenantClaim (parents)
      // and claimSetupToken (admin promotion) create + initialize the
      // doc with role + createdAt. Clients can't create user docs.
      allow create: if false;

      // Self-update: a user may write ONLY to the mirrored profile
      // fields plus the lastModified summary object on their own doc.
      // The diff-affectedKeys check ensures they can't sneak in role /
      // createdAt / promotedToAdminAt edits.
      // ITEM 9c.2 — AuthContext writes these on sign-in / profile change.
      // Future ITEM 12 will extend this list with 'onboarding'.
      allow update: if isTenantAdmin(tenantId) ||
                       (isSelf(uid) && inTenant(tenantId) &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['displayName', 'photoURL', 'email',
                                    'lastSeenAt', 'lastModified']));

      allow delete: if isTenantAdmin(tenantId);
    }

    // ── LOOT SESSIONS (admin AI conversations) ──
    // One doc per chat session keyed by a per-tab UUID. The `turns`
    // array is rewritten on every model response (capped at last
    // 50). ITEM 9c.1a wired this up.
    //
    //   Read    — any admin of this tenant. Modeled after MCL's
    //             adminChatLogs pattern: admins as a group benefit
    //             from seeing each other's questions to LOOT, and
    //             the weekly insight digest (9c.1b) needs read
    //             access too (it runs server-side with Admin SDK
    //             so it bypasses these rules, but keeping read
    //             open to admins lets the UI viewer (9c.1c) work).
    //   Create  — only an admin can create, and the doc's userUid
    //             must match the caller. Prevents one admin from
    //             impersonating another in the session log.
    //   Update  — only the original session owner can append more
    //             turns. Other admins can read but can't modify.
    //   Delete  — any tenant admin can purge a session (operator
    //             control + future retention cleanup).
    //
    // Audience values: 'admin' for now. 'parent' / 'anon' arrive
    // in 9f and 9g respectively, and we'll widen the rules then.
    match /{tenantId}/_main/lootSessions/{sessionId} {
      allow read  : if isTenantAdmin(tenantId);
      allow create: if isTenantAdmin(tenantId) &&
                       request.resource.data.userUid == request.auth.uid;
      allow update: if isTenantAdmin(tenantId) &&
                       resource.data.userUid == request.auth.uid;
      allow delete: if isTenantAdmin(tenantId);
    }

    // ── USER AUDIT TRAIL (lastModifieds subcollection) ──
    // Each entry is a snapshot of the previous `lastModified` summary
    // that was on the user doc before the latest update overwrote it.
    // Archive is append-only — once written, an entry can never be
    // edited or deleted by anyone (including the user themselves).
    // Only the user (for their own history) and admins (for any user)
    // can read the audit trail.
    match /{tenantId}/_main/users/{uid}/lastModifieds/{lmId} {
      allow read         : if (isSelf(uid) && inTenant(tenantId)) ||
                              isTenantAdmin(tenantId);
      allow create       : if (isSelf(uid) && inTenant(tenantId)) ||
                              isTenantAdmin(tenantId);
      allow update, delete: if false;
    }

    // ── CHILDREN (sub-profiles under a parent's user doc) ──
    match /{tenantId}/_main/users/{uid}/children/{childId} {
      allow read, write: if (isSelf(uid) && inTenant(tenantId)) ||
                            isTenantAdmin(tenantId);
    }

    // ── DEFAULT AVATAR PACK ──
    // Metadata for the avatars the admin uploaded to Storage at
    // /{tenantId}/avatars/. Public-read so the parent dashboard's
    // child-profile picker can render the grid without auth gating.
    // Admin-write only.
    match /{tenantId}/_main/avatars/{avatarId} {
      allow read : if true;
      allow write: if isTenantAdmin(tenantId);
    }

    // ── BOOKS (admin-curated catalog) ──
    // Books admins add to the library's active reward shelf. Public-read
    // so anonymous visitors browsing /books and kids reading the home
    // page can see the catalog. Admin-write only.
    match /{tenantId}/_main/books/{bookId} {
      allow read : if true;
      allow write: if isTenantAdmin(tenantId);
    }
  }
}
