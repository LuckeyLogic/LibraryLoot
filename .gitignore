node_modules/

# Build output
dist/
dist-ssr/

# Environment / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
service-account*.json

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
.firebaserc.local

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
