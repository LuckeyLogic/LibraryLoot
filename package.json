{
  "name": "library-loot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Community-funded reading rewards platform for libraries.",
  "license": "MIT",
  "author": "Luckey Logic LLC",
  "homepage": "https://github.com/LuckeyLogic/LibraryLoot",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuckeyLogic/LibraryLoot.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docs:sync-tokens": "cp src/styles/tokens.css jsdoc-template/static/styles/tokens.css",
    "docs:build-info": "node scripts/write-docs-build-info.js",
    "docs": "npm run docs:sync-tokens && npm run docs:build-info && jsdoc -c jsdoc.config.json",
    "build:all": "npm run build && npm run docs && rm -rf dist/docs && cp -r docs dist/docs"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.0",
    "firebase": "^12.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdoc": "^4.0.4",
    "vite": "^5.4.11"
  }
}
