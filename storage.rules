rules_version = '2';

// Library Loot — Firebase Storage Security Rules (ITEM 2c)
//
// Multi-tenant: every Storage object lives under a path that begins with
// the tenant ID. Public-read where appropriate (site branding, book covers,
// sponsor logos shown on the public Donors wall). Writes restricted to
// tenant admins. Cloud Functions / Firebase Extensions (Resize Images)
// bypass these rules via Admin SDK.

service firebase.storage {
  match /b/{bucket}/o {

    // ── PUBLIC TENANT ASSETS ──
    // Hero, branding, origin-story portrait. Anyone on the web reads;
    // only admins of this tenant write.
    match /{tenantId}/assets/{allPaths=**} {
      allow read : if true;
      allow write: if request.auth != null
                    && request.auth.token.tenant == tenantId
                    && request.auth.token.admin == true;
    }

    // ── SPONSOR LOGOS ── (public read for Donors wall)
    match /{tenantId}/sponsors/{sponsorId}/{file=**} {
      allow read : if true;
      allow write: if request.auth != null
                    && request.auth.token.tenant == tenantId
                    && request.auth.token.admin == true;
    }

    // ── BOOK COVERS ── (public read, cached from Open Library)
    match /{tenantId}/books/{bookId}/{file=**} {
      allow read : if true;
      allow write: if request.auth != null
                    && request.auth.token.tenant == tenantId
                    && request.auth.token.admin == true;
    }

    // ── DEFAULT: deny ──
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
