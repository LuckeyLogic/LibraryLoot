{
  "source": {
    "include":        ["src"],
    "includePattern": ".+\\.jsx?$",
    "excludePattern": "(node_modules|dist|docs)"
  },
  "plugins": [
    "plugins/markdown"
  ],
  "opts": {
    "destination": "./docs",
    "recurse":     true,
    "readme":      "./README.md"
  },
  "templates": {
    "cleverLinks":    true,
    "monospaceLinks": true
  }
}
