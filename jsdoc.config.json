{
  "source": {
    "include": [
      "src/components",
      "src/pages",
      "src/context",
      "src/data",
      "src/firebase.js",
      "src/firebase",
      "src/hooks",
      "src/lib",
      "src/model",
      "src/utils",
      "src/App.jsx",
      "src/main.jsx"
    ],
    "includePattern": "\\.(jsx|js)$",
    "excludePattern": "(node_modules|dist|docs|public)"
  },
  "opts": {
    "destination": "docs",
    "recurse":     true,
    "readme":      "jsdoc-readme.md",
    "template":    "./jsdoc-template"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks":    false,
    "monospaceLinks": false,
    "default": {
      "outputSourceFiles": true,
      "includeDate":       false
    }
  },
  "metadata": {
    "title": "Library Loot — Developer Reference"
  }
}
